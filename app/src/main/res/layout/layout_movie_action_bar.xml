<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_action_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="15dp">

    <LinearLayout
        android:id="@+id/btn_favorite"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_btn_favorite"
            android:layout_width="42dp"
            android:layout_height="35dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_x_favorite"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txt_btn_favorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_favorite"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_share"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_share"
            android:layout_width="46dp"
            android:layout_height="35dp"
            android:importantForAccessibility="no"
            android:padding="2dp"
            app:srcCompat="@drawable/ic_x_share"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <ImageView
            android:layout_width="127dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/rounder_rating_bg"
            app:tint="@color/light_green" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:layout_marginEnd="24dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_x_star"
            app:tint="@color/dark_green" />

        <ImageView
            android:id="@+id/img_star_fill"
            android:layout_width="34dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:layout_marginEnd="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/star_clip"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txt_detail_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="3dp"
            android:text="7.5/10"
            android:textColor="@color/white"
            android:shadowColor="@color/black"
            android:shadowRadius="2"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>