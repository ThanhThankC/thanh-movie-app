<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip_history"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/rounder_text_history"
    android:paddingTop="1dp"
    android:paddingBottom="0dp"
    android:layout_margin="4dp"
    >
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/ic_x_history"
        android:backgroundTint="@color/light_gray"
        android:scaleType="centerCrop"
        />
    <TextView
        android:id="@+id/txt_history_keyword"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:maxWidth="230dp"
        android:text="phim aaa sdshshds"
        android:textAlignment="center"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:paddingTop="2dp"
        android:textColor="@color/light_gray"
        />
    <ImageButton
        android:id="@+id/btn_history_remove"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="-3dp"
        android:layout_marginLeft="-1dp"
        android:background="@drawable/ic_x_clear"
        android:backgroundTint="@color/light_gray"
        android:scaleType="centerCrop"
        />
</LinearLayout>