<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_overlay2"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_favorite"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="18dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp"
            android:layout_marginTop="60dp"
            />

        <TextView
            android:id="@+id/txt_empty_favorite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="16sp"
            android:padding="32dp"
            android:textColor="@color/light_gray"
            android:text="@string/no_favorite_yet" />

    </LinearLayout>

    <Spinner
        android:id="@+id/spinner_favorite_sort"
        android:layout_width="150dp"
        android:layout_height="35dp"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:layout_gravity="end"
        android:popupBackground="@drawable/rounded_dropdown_bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />

    <include layout="@layout/layout_favorite_header"/>
</FrameLayout>